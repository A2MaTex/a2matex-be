NODE_ENV=development
HOST=0.0.0.0
PORT=9999
API_PREFIX=api/v1
# Origin của frontend, phân tách bằng dấu phẩy. Để * khi phát triển.
CORS_ORIGIN=*
# Số lớp reverse proxy đứng trước app. false khi chạy trực tiếp.
TRUST_PROXY=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=a2matex
POSTGRES_PASSWORD=a2matex
POSTGRES_DB=a2matex
DATABASE_URL="postgresql://a2matex:a2matex@localhost:5432/a2matex?schema=public"

ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=3d
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

OTP_EXPIRES_IN=5m
RESEND_API_KEY=
EMAIL_FROM="A2MaTeX <onboarding@resend.dev>"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=a2matex:

ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
STATIC_UPLOAD_MAX_SIZE_MB=5

SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_NAME=
SEPAY_BANK_ACCOUNT_HOLDER=
SEPAY_API_BASE_URL=https://my.sepay.vn/userapi
SEPAY_API_TOKEN=
SEPAY_RECONCILE_INTERVAL_MINUTES=15

# Cron service (npm run start:cron:dev). Reads this same .env; must not share PORT with the API.
CRON_PORT=9998
# Seconds an in-flight job may finish after SIGTERM before the process exits anyway.
CRON_SHUTDOWN_GRACE_SECONDS=30
# Cron expression for the Sepay reconciliation job. Empty = */<SEPAY_RECONCILE_INTERVAL_MINUTES> * * * *.
# "off" disables the job. A schedule sparser than the lookback window above can miss
# transactions, so change both together.
CRON_TOPUP_RECONCILE=

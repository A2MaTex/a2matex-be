NODE_ENV=development
HOST=0.0.0.0
PORT=9999
API_PREFIX=api/v1
# Origin của frontend, phân tách bằng dấu phẩy. Để * khi phát triển.
CORS_ORIGIN=*
# Số lớp reverse proxy đứng trước app. false khi chạy trực tiếp.
TRUST_PROXY=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=a2matex
POSTGRES_PASSWORD=a2matex
POSTGRES_DB=a2matex
DATABASE_URL="postgresql://a2matex:a2matex@localhost:5432/a2matex?schema=public"

ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=3d
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

OTP_EXPIRES_IN=5m
RESEND_API_KEY=
EMAIL_FROM="A2MaTeX <onboarding@resend.dev>"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

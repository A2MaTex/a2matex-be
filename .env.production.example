# ---------------------------------------------------------------------------
# Production environment for the Docker Compose stack in deploy/.
# Lives ONLY on the VPS at /opt/a2matex/.env.production. Never commit it.
# ---------------------------------------------------------------------------

# --- Image (pulled from GHCR; IMAGE_TAG is written to .env.deploy by CI) -----
IMAGE_REPO=ghcr.io/a2matex/a2matex-be

# --- Reverse proxy (read by Caddy, not by the app) ---------------------------
APP_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# --- Application ---------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=9999
API_PREFIX=api/v1
# Comma-separated frontend origins. Explicit origins are required in production.
CORS_ORIGIN=https://example.com
# Caddy is the single proxy hop in front of the app.
TRUST_PROXY=1

# --- PostgreSQL (Cloud SQL, reached over the VPC private IP; runbook A5) --------
# Postgres is not part of the compose stack. POSTGRES_HOST is the PRIVATE IP of the
# Cloud SQL instance a2matex-pg. DATABASE_URL must keep both trailing parameters:
#   sslmode=require        Cloud SQL only accepts encrypted connections
#   uselibpqcompat=true    the pg driver otherwise verifies the server cert against
#                          the system CA store and fails on Cloud SQL's private CA
# Prisma CLI (the migrate job) ignores uselibpqcompat, so one URL serves both.
POSTGRES_HOST=CHANGE_ME_PRIVATE_IP
POSTGRES_PORT=5432
POSTGRES_USER=a2matex
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=a2matex
DATABASE_URL="postgresql://a2matex:CHANGE_ME_STRONG_PASSWORD@CHANGE_ME_PRIVATE_IP:5432/a2matex?schema=public&sslmode=require&uselibpqcompat=true"

# --- JWT (each: openssl rand -hex 32; production requires >= 32 chars) --------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=3d

# --- Email (Resend) ------------------------------------------------------------
OTP_EXPIRES_IN=5m
RESEND_API_KEY=
EMAIL_FROM="A2MaTeX <no-reply@example.com>"

# --- Object storage (S3-compatible, optional) ----------------------------------
# Leave the key fields blank to run without the upload feature. ACCESS_KEY_ID and
# SECRET_ACCESS_KEY must be set together. Works with Cloudflare R2, MinIO, GCS S3 API.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
STATIC_UPLOAD_MAX_SIZE_MB=5

# --- Redis (hostname is the compose service name) ------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_PREFIX=a2matex:

# --- Seed bootstrap (only read by the manual seed-roles job) -------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Sepay top-up -----------------------------------------------------------
SEPAY_WEBHOOK_API_KEY=CHANGE_ME_SEPAY_WEBHOOK_API_KEY
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_NAME=
SEPAY_BANK_ACCOUNT_HOLDER=
SEPAY_API_BASE_URL=https://my.sepay.vn/userapi
SEPAY_API_TOKEN=CHANGE_ME_SEPAY_API_TOKEN
SEPAY_RECONCILE_INTERVAL_MINUTES=15

# --- Cron service (container a2matex-cron, same image and env as app) ---------
# Internal port for the health check only; never published by compose or Caddy.
CRON_PORT=9998
# Seconds an in-flight job may finish after SIGTERM before the process exits anyway.
# compose sets stop_grace_period larger than this value.
CRON_SHUTDOWN_GRACE_SECONDS=30
# Cron expression for the Sepay reconciliation job. Empty = */<SEPAY_RECONCILE_INTERVAL_MINUTES> * * * *.
# "off" disables the job. Keep it at least as frequent as the lookback window above.
CRON_TOPUP_RECONCILE=

# --- Kafka and queue consumer -------------------------------------------------
# Roll out in two deploys (specs/006-kafka-broker-deployment): deploy the broker and
# kafka-init with KAFKA_ENABLED=false first, then flip it to true in a second deploy.
# Enabling it with an empty KAFKA_BROKERS stops app, cron AND consumer at startup,
# so validate before replacing containers:
#   a2c run --rm --entrypoint node app -e "import('/app/dist/shared/config.js')"
KAFKA_ENABLED=false
# Internal listener on the backend network; the broker publishes no host port.
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=a2matex-api
# Prefixes BOTH topic names and consumer group ids, so Kafka UI shows
# "production.submission-scan", not "submission-scan".
KAFKA_TOPIC_PREFIX=production
KAFKA_SSL=false

QUEUE_CONSUMER_HOST=0.0.0.0
QUEUE_CONSUMER_PORT=9997

# --- Kafka UI (read-only, behind Caddy basic auth) ----------------------------
# Read by Caddy and compose only; the app never sees these.
KAFKA_UI_DOMAIN=kafka.example.com
KAFKA_UI_UPSTREAM=kafka-ui:8080
KAFKA_UI_USER=CHANGE_ME_KAFKA_UI_USER
# Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# Then DOUBLE every "$" in the result. Compose interpolates variables inside env files,
# so a plain "$2a$14$..." reaches the container truncated to "$2a$14" and nobody can log in.
# Verify with `a2c exec caddy printenv KAFKA_UI_PASSWORD_HASH` (one "$" per group),
# never with `docker run --env-file`, which does not interpolate and shows the doubled form.
KAFKA_UI_PASSWORD_HASH=CHANGE_ME_$$2a$$14$$BCRYPT_HASH

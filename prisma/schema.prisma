generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id                                                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                                            String             @db.VarChar(255)
  email                                               String
  password                                            String             @db.VarChar(255)
  status                                              UserStatus         @default(INACTIVE)
  createdAt                                           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                                           DateTime?          @db.Timestamptz(6)
  deletedAt                                           DateTime?          @db.Timestamptz(6)
  device                                              Device[]
  createdPermissions                                  Permission[]       @relation("PermissionCreatedBy")
  deletedPermissions                                  Permission[]       @relation("PermissionDeletedBy")
  updatedPermissions                                  Permission[]       @relation("PermissionUpdatedBy")
  createdProfiles                                     Profile[]          @relation("ProfileCreatedBy")
  deletedProfiles                                     Profile[]          @relation("ProfileDeletedBy")
  updatedProfiles                                     Profile[]          @relation("ProfileUpdatedBy")
  profile                                             Profile?           @relation("ProfileUser")
  Project_Project_createdByIdToUser                   Project[]          @relation("Project_createdByIdToUser")
  Project_Project_deletedByIdToUser                   Project[]          @relation("Project_deletedByIdToUser")
  Project_Project_updatedByIdToUser                   Project[]          @relation("Project_updatedByIdToUser")
  ProjectDraft                                        ProjectDraft[]
  blockedPublisherAccounts                            PublisherAccount[] @relation("PublisherAccount_blockedByIdToUser")
  publisherAccount                                    PublisherAccount?  @relation("PublisherAccount_userIdToUser")
  refreshTokens                                       RefreshToken[]
  createdRoles                                        Role[]             @relation("RoleCreatedBy")
  deletedRoles                                        Role[]             @relation("RoleDeletedBy")
  updatedRoles                                        Role[]             @relation("RoleUpdatedBy")
  createdTerms                                        Term[]             @relation("Term_createdByIdToUser")
  updatedTerms                                        Term[]             @relation("Term_updatedByIdToUser")
  userRoles                                           UserRole[]
  WorkflowRevision_WorkflowRevision_createdByIdToUser WorkflowRevision[] @relation("WorkflowRevision_createdByIdToUser")
  WorkflowRevision_WorkflowRevision_deletedByIdToUser WorkflowRevision[] @relation("WorkflowRevision_deletedByIdToUser")
  WorkflowRevision_WorkflowRevision_updatedByIdToUser WorkflowRevision[] @relation("WorkflowRevision_updatedByIdToUser")
}

model Profile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @unique(map: "Profile_userId_idx", where: raw("(\"deletedAt\" IS NULL)")) @db.Uuid
  fullName       String    @db.VarChar(255)
  avatarStaticId String?   @db.Uuid
  bio            String?
  website        String?
  twitter        String?
  linkedin       String?
  github         String?
  instagram      String?
  gender         String?   @db.VarChar(20)
  birthday       DateTime? @db.Date
  address        String?
  phone          String?
  email          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime? @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)
  createdById    String    @db.Uuid
  updatedById    String?   @db.Uuid
  deletedById    String?   @db.Uuid
  balance        BigInt    @default(0)
  Static         Static?   @relation(fields: [avatarStaticId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy      User      @relation("ProfileCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedBy      User?     @relation("ProfileDeletedBy", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy      User?     @relation("ProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User      @relation("ProfileUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model TopUpTransaction {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String?                @db.Uuid
  referenceCode         String?                @unique(map: "TopUpTransaction_referenceCode_idx")
  requestedAmount       BigInt?
  receivedAmount        BigInt?
  providerTransactionId String?                @unique(map: "TopUpTransaction_providerTransactionId_idx")
  rawContent            String?
  status                TopUpTransactionStatus
  creditedAt            DateTime?              @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime?              @db.Timestamptz(6)
}

model VerificationCode {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String               @db.VarChar(500)
  code      String               @db.VarChar(50)
  type      VerificationCodeType
  expiresAt DateTime             @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime?            @db.Timestamptz(6)
  deletedAt DateTime?            @db.Timestamptz(6)

  @@unique([email, type], map: "VerificationCode_email_type_idx", where: raw("(\"deletedAt\" IS NULL)"))
}

model Device {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @db.Uuid
  userAgent     String
  ip            String
  lastActive    DateTime       @db.Timestamptz(6)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime?      @db.Timestamptz(6)
  deletedAt     DateTime?      @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique(map: "RefreshToken_token_idx", where: raw("(\"deletedAt\" IS NULL)"))
  userId    String    @db.Uuid
  deviceId  String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @db.VarChar(500)
  module          String           @db.VarChar(100)
  description     String
  path            String           @db.VarChar(1000)
  method          HTTPMethod
  createdById     String           @db.Uuid
  updatedById     String?          @db.Uuid
  deletedById     String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime?        @db.Timestamptz(6)
  deletedAt       DateTime?        @db.Timestamptz(6)
  scope           PermissionScope?
  createdBy       User             @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedBy       User?            @relation("PermissionDeletedBy", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy       User?            @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolePermissions RolePermission[]

  @@unique([method, path, scope], map: "Permission_method_path_scope_idx", where: raw("((scope IS NOT NULL) AND (\"deletedAt\" IS NULL))"))
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @db.VarChar(500)
  description     String?
  status          RoleStatus       @default(ACTIVE)
  createdById     String           @db.Uuid
  updatedById     String?          @db.Uuid
  deletedById     String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime?        @db.Timestamptz(6)
  deletedAt       DateTime?        @db.Timestamptz(6)
  createdBy       User             @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedBy       User?            @relation("RoleDeletedBy", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy       User?            @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime?  @db.Timestamptz(6)
  deletedAt    DateTime?  @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, permissionId], map: "RolePermission_roleId_permissionId_idx", where: raw("(\"deletedAt\" IS NULL)"))
}

model UserRole {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PublisherAccount {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                     @unique @db.Uuid
  status           PublisherAccountStatus     @default(ACTIVE)
  activatedAt      DateTime                   @default(now()) @db.Timestamptz(6)
  blockedReason    String?
  blockedAt        DateTime?                  @db.Timestamptz(6)
  blockedById      String?                    @db.Uuid
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime?                  @db.Timestamptz(6)
  deletedAt        DateTime?                  @db.Timestamptz(6)
  Project          Project[]
  blockedBy        User?                      @relation("PublisherAccount_blockedByIdToUser", fields: [blockedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User                       @relation("PublisherAccount_userIdToUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  termsAcceptances PublisherTermsAcceptance[]
}

model PublisherTermsAcceptance {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publisherAccountId String           @db.Uuid
  termId             String           @db.Uuid
  acceptedAt         DateTime         @default(now()) @db.Timestamptz(6)
  acceptanceMetadata Json             @default("{}")
  publisherAccount   PublisherAccount @relation(fields: [publisherAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  term               Term             @relation(fields: [termId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([publisherAccountId, termId], map: "PublisherTermsAcceptance_account_term_key")
}

model Term {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                 TermType                   @unique(map: "Term_one_active_type_idx", where: raw("((status = 'ACTIVE'::\"TermStatus\") AND (\"deletedAt\" IS NULL))"))
  version              String                     @db.VarChar(100)
  title                String                     @db.VarChar(500)
  content              String
  status               TermStatus                 @default(DRAFT)
  publishedAt          DateTime?                  @db.Timestamptz(6)
  createdById          String                     @db.Uuid
  updatedById          String?                    @db.Uuid
  createdAt            DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime?                  @db.Timestamptz(6)
  deletedAt            DateTime?                  @db.Timestamptz(6)
  publisherAcceptances PublisherTermsAcceptance[]
  createdBy            User                       @relation("Term_createdByIdToUser", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy            User?                      @relation("Term_updatedByIdToUser", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([type, version])
}

model Static {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectKey          String               @unique
  originalFileName   String
  contentType        String               @db.VarChar(255)
  size               BigInt
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?            @db.Timestamptz(6)
  deletedAt          DateTime?            @db.Timestamptz(6)
  launcherReleases   LauncherRelease[]
  Profile            Profile[]
  StaticImageVariant StaticImageVariant[]
}

model LauncherRelease {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version      String    @db.VarChar(100)
  staticId     String    @db.Uuid
  releaseNotes String?
  isActive     Boolean   @default(false)
  publishedAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime? @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  static       Static    @relation(fields: [staticId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Capability {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String                     @unique @db.VarChar(255)
  name                     String                     @db.VarChar(255)
  description              String
  isSensitive              Boolean                    @default(false)
  createdAt                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime?                  @db.Timestamptz(6)
  deletedAt                DateTime?                  @db.Timestamptz(6)
  NodeDefinitionCapability NodeDefinitionCapability[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model NodeDefinition {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                     String                     @unique @db.VarChar(255)
  name                     String                     @db.VarChar(255)
  description              String
  category                 String                     @db.VarChar(100)
  status                   NodeDefinitionStatus       @default(ACTIVE)
  runtimeHandler           String                     @db.VarChar(255)
  minimumRuntimeVersion    String                     @db.VarChar(100)
  defaultTimeoutMs         Int
  configSchema             Json
  inputSchema              Json
  outputSchema             Json
  outputPorts              Json
  editorHints              Json
  supportedErrorPolicies   Json
  contentHash              String                     @db.VarChar(64)
  createdAt                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime?                  @db.Timestamptz(6)
  deletedAt                DateTime?                  @db.Timestamptz(6)
  NodeDefinitionCapability NodeDefinitionCapability[]

  @@index([status, type])
}

model NodeDefinitionCapability {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeDefinitionId String         @db.Uuid
  capabilityId     String         @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime?      @db.Timestamptz(6)
  deletedAt        DateTime?      @db.Timestamptz(6)
  Capability       Capability     @relation(fields: [capabilityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  NodeDefinition   NodeDefinition @relation(fields: [nodeDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([nodeDefinitionId, capabilityId], map: "NodeDefinitionCapability_node_capability_key")
  @@index([capabilityId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Project {
  id                             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publisherAccountId             String             @db.Uuid
  name                           String             @db.VarChar(255)
  description                    String?
  status                         ProjectStatus      @default(ACTIVE)
  createdAt                      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime?          @db.Timestamptz(6)
  deletedAt                      DateTime?          @db.Timestamptz(6)
  createdById                    String             @db.Uuid
  updatedById                    String?            @db.Uuid
  deletedById                    String?            @db.Uuid
  User_Project_createdByIdToUser User               @relation("Project_createdByIdToUser", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User_Project_deletedByIdToUser User?              @relation("Project_deletedByIdToUser", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  PublisherAccount               PublisherAccount   @relation(fields: [publisherAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User_Project_updatedByIdToUser User?              @relation("Project_updatedByIdToUser", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ProjectDraft                   ProjectDraft?
  WorkflowRevision               WorkflowRevision[]

  @@index([publisherAccountId, status], where: raw("(\"deletedAt\" IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ProjectDraft {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String    @unique @db.Uuid
  version           Int       @default(1)
  editorGraph       Json
  inputSchema       Json
  runtimeIr         Json?
  validationSummary Json      @default("{}")
  testSummary       Json      @default("{}")
  contentHash       String    @db.VarChar(64)
  savedAt           DateTime  @default(now()) @db.Timestamptz(6)
  savedById         String    @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime? @db.Timestamptz(6)
  deletedAt         DateTime? @db.Timestamptz(6)
  Project           Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User              User      @relation(fields: [savedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model WorkflowRevision {
  id                                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                               String    @db.Uuid
  sourceDraftVersion                      Int
  sourceDraftContentHash                  String    @db.VarChar(64)
  editorGraph                             Json
  runtimeIr                               Json
  inputSchema                             Json
  nodeDefinitionManifest                  Json
  capabilityManifest                      Json
  validationSummary                       Json
  testSummary                             Json      @default("{}")
  contentHash                             String    @db.VarChar(64)
  createdAt                               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                               DateTime? @db.Timestamptz(6)
  deletedAt                               DateTime? @db.Timestamptz(6)
  createdById                             String    @db.Uuid
  updatedById                             String?   @db.Uuid
  deletedById                             String?   @db.Uuid
  User_WorkflowRevision_createdByIdToUser User      @relation("WorkflowRevision_createdByIdToUser", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User_WorkflowRevision_deletedByIdToUser User?     @relation("WorkflowRevision_deletedByIdToUser", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Project                                 Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User_WorkflowRevision_updatedByIdToUser User?     @relation("WorkflowRevision_updatedByIdToUser", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, sourceDraftVersion], map: "WorkflowRevision_project_draftVersion_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model StaticImageVariant {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staticId    String                 @db.Uuid
  variant     StaticImageVariantType
  objectKey   String                 @unique
  contentType String                 @db.VarChar(255)
  size        BigInt
  width       Int
  height      Int
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  Static      Static                 @relation(fields: [staticId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([staticId, variant])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum VerificationCodeType {
  REGISTER
  FORGOT_PASSWORD
  LOGIN
  DISABLE_2FA
}

enum HTTPMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}

enum PublisherAccountStatus {
  ACTIVE
  BLOCKED
}

enum TermStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TermType {
  PUBLISHER_TERMS
  CUSTOMER_TERMS
  PRIVACY_POLICY
}

enum TopUpTransactionStatus {
  PENDING
  CREDITED
  UNMATCHED
}

enum NodeDefinitionStatus {
  ACTIVE
  DISABLED
}

enum PermissionScope {
  OWN
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum StaticImageVariantType {
  SMALL
  MEDIUM
}

{
	email {$ACME_EMAIL}
}

# Caddy obtains and renews the Let's Encrypt certificate for APP_DOMAIN and
# redirects plain HTTP to HTTPS.
{$APP_DOMAIN} {
	encode zstd gzip

	# Caddy terminates TLS and is the single proxy hop in front of the API.
	# Keep TRUST_PROXY=1 in .env.production so @Ip() reports the real client.
	reverse_proxy {$APP_UPSTREAM} {
		# Hold requests while the app container is being replaced during a deploy
		# instead of answering 502. No active health check: with a single upstream
		# it only creates a window of 503s after every restart.
		lb_try_duration 20s
		lb_try_interval 500ms
		fail_duration 5s
		max_fails 3
	}

	log {
		output stdout
		format console
	}
}

# Kafka UI. Separate site block so a problem with this name cannot take down the
# API above; Caddy issues and renews its certificate independently.
{$KAFKA_UI_DOMAIN} {
	encode zstd gzip

	# The only thing between the public internet and every message body in the
	# queue. The cluster itself is configured read-only as a second layer.
	basic_auth {
		{$KAFKA_UI_USER} {$KAFKA_UI_PASSWORD_HASH}
	}

	reverse_proxy {$KAFKA_UI_UPSTREAM}

	log {
		output stdout
		format console
	}
}

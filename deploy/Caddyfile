{
	email {$ACME_EMAIL}
}

# Caddy obtains and renews the Let's Encrypt certificate for APP_DOMAIN and
# redirects plain HTTP to HTTPS.
{$APP_DOMAIN} {
	encode zstd gzip

	# Caddy terminates TLS and is the single proxy hop in front of the API.
	# Keep TRUST_PROXY=1 in .env.production so @Ip() reports the real client.
	reverse_proxy {$APP_UPSTREAM} {
		# Hold requests while the app container is being replaced during a deploy
		# instead of answering 502. No active health check: with a single upstream
		# it only creates a window of 503s after every restart.
		lb_try_duration 20s
		lb_try_interval 500ms
		fail_duration 5s
		max_fails 3
	}

	log {
		output stdout
		format console
	}
}
